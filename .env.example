# PostgreSQL Database URL (from Render, Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://snai3i_user:password@localhost:5432/snai3i

# Django Secret Key (generate a random secure string for production)
SECRET_KEY=your-production-django-secret-key-here

# Django Debug Mode (set to False for production)
DEBUG=False

# Allowed Hosts (comma-separated or * for all)
ALLOWED_HOSTS=*

# CSRF Trusted Origins (e.g. https://snai3i-points-tracker.onrender.com)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
