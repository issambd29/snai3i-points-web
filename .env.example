# Copy to ".env" for local development (it is git-ignored). Real environment
# variables always take priority over this file.

# --- Django ---------------------------------------------------------------
# Required whenever DEBUG is not True. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me
DEBUG=True

# Comma-separated hosts, e.g. snai3i.example.com (Render's hostname is added automatically)
ALLOWED_HOSTS=
# Comma-separated, with scheme, e.g. https://snai3i.example.com  (no wildcards)
CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------------
# Omit for local SQLite. In production this is required.
# From outside Render use the EXTERNAL connection string.
DATABASE_URL=

# --- Accounts -----------------------------------------------------------------
ADMIN_EMAIL=admin@snai3i.com
ADMIN_USERNAME=admin
# If empty a random password is generated and printed once by `createadmin`.
ADMIN_PASSWORD=
# Let anyone register a teacher account via the API (default: off).
ALLOW_PUBLIC_SIGNUP=False
# Local demo teachers/students. Never enable in production.
SEED_DEMO_DATA=False

# --- Build time (frontend) --------------------------------------------------------
# Public URL of the site, used for canonical/Open Graph tags, sitemap and robots.txt.
SITE_URL=
